<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Divider Pro - Chia Nhóm Thông Minh & Công Bằng</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen font-sans p-6">
    <div class="max-w-6xl mx-auto space-y-6">
        <!-- Header -->
        <header class="text-center space-y-2 border-b border-slate-700 pb-6">
            <h1 class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">
                <i class="fa-solid fa-users-gear mr-2"></i>SMART DIVIDER PRO
            </h1>
            <p class="text-slate-400">Hệ thống phân nhóm thông minh, công bằng và tối ưu năng lực bằng Thuật toán Snake Draft</p>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Form nhập dữ liệu -->
            <div class="bg-slate-800 p-5 rounded-xl border border-slate-700 space-y-4 shadow-xl">
                <h2 class="text-xl font-bold text-blue-400 flex items-center gap-2">
                    <i class="fa-solid fa-user-plus"></i> Dữ liệu đầu vào
                </h2>
                <div>
                    <label class="block text-sm text-slate-300 mb-1">Danh sách thành viên (Tên, Điểm 1-10):</label>
                    <textarea id="rawInput" rows="8" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-3 text-sm focus:ring-2 focus:ring-blue-500 outline-none text-slate-200" placeholder="An, 9&#10;Bình, 7&#10;Cường, 8&#10;Dũng, 5&#10;Giang, 10&#10;Hương, 6&#10;Khánh, 4&#10;Lan, 8"></textarea>
                    <span class="text-xs text-slate-500">Định dạng: Tên, Điểm số (Mỗi người 1 dòng)</span>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm text-slate-300 mb-1">Số nhóm chia:</label>
                        <input type="number" id="teamCount" value="2" min="2" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-center font-bold text-blue-400">
                    </div>
                    <div>
                        <label class="block text-sm text-slate-300 mb-1">Chế độ chia:</label>
                        <select id="mode" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-sm">
                            <option value="balanced">Công bằng (Snake Draft)</option>
                            <option value="random">Ngẫu nhiên (Random)</option>
                        </select>
                    </div>
                </div>

                <button onclick="generateTeams()" class="w-full bg-gradient-to-r from-blue-600 to-emerald-600 hover:from-blue-500 hover:to-emerald-500 text-white font-bold py-3 rounded-lg shadow-lg transition duration-200">
                    <i class="fa-solid fa-wand-magic-sparkles mr-2"></i> Tiến hành Phân Nhóm
                </button>
            </div>

            <!-- Display Results -->
            <div class="lg:col-span-2 bg-slate-800 p-5 rounded-xl border border-slate-700 shadow-xl space-y-4">
                <div class="flex justify-between items-center border-b border-slate-700 pb-3">
                    <h2 class="text-xl font-bold text-emerald-400 flex items-center gap-2">
                        <i class="fa-solid fa-chart-pie"></i> Kết quả phân nhóm
                    </h2>
                    <span id="statBadge" class="text-xs bg-slate-700 px-3 py-1 rounded-full text-slate-300">Sẵn sàng</span>
                </div>

                <div id="teamsContainer" class="grid grid-cols-1 md:grid-cols-2 gap-4 min-h-[300px]">
                    <div class="col-span-full flex flex-col items-center justify-center text-slate-500 py-12">
                        <i class="fa-solid fa-diagram-project text-5xl mb-3"></i>
                        <p>Nhập danh sách và nhấn "Tiến hành Phân Nhóm" để xem kết quả</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function parseInput(text) {
            const lines = text.trim().split('\n');
            const members = [];
            lines.forEach((line, index) => {
                if (!line.trim()) return;
                const parts = line.split(',');
                const name = parts[0]?.trim() || `Thành viên ${index + 1}`;
                const score = parseFloat(parts[1]?.trim()) || 5;
                members.push({ name, score });
            });
            return members;
        }

        function generateTeams() {
            const rawText = document.getElementById('rawInput').value;
            const numTeams = parseInt(document.getElementById('teamCount').value) || 2;
            const mode = document.getElementById('mode').value;
            const members = parseInput(rawText);

            if (members.length < numTeams) {
                alert('Số lượng thành viên phải lớn hơn hoặc bằng số nhóm!');
                return;
            }

            let teams = Array.from({ length: numTeams }, (_, i) => ({
                id: i + 1,
                members: [],
                totalScore: 0
            }));

            if (mode === 'random') {
                const shuffled = [...members].sort(() => Math.random() - 0.5);
                shuffled.forEach((m, idx) => {
                    teams[idx % numTeams].members.push(m);
                    teams[idx % numTeams].totalScore += m.score;
                });
            } else {
                const sorted = [...members].sort((a, b) => b.score - a.score);
                let teamIdx = 0;
                let direction = 1;

                sorted.forEach(m => {
                    teams[teamIdx].members.push(m);
                    teams[teamIdx].totalScore += m.score;

                    teamIdx += direction;
                    if (teamIdx >= numTeams) {
                        teamIdx = numTeams - 1;
                        direction = -1;
                    } else if (teamIdx < 0) {
                        teamIdx = 0;
                        direction = 1;
                    }
                });
            }

            renderTeams(teams);
        }

        function renderTeams(teams) {
            const container = document.getElementById('teamsContainer');
            container.innerHTML = '';

            let minScore = Infinity, maxScore = -Infinity;

            teams.forEach(team => {
                const avgScore = (team.totalScore / team.members.length).toFixed(1);
                if (team.totalScore < minScore) minScore = team.totalScore;
                if (team.totalScore > maxScore) maxScore = team.totalScore;

                const teamEl = document.createElement('div');
                teamEl.className = 'bg-slate-900 border border-slate-700 rounded-lg p-4 space-y-3 flex flex-col justify-between shadow-md';
                
                let membersList = team.members.map(m => `
                    <li class="flex justify-between items-center text-sm py-1 border-b border-slate-800">
                        <span class="text-slate-200">${m.name}</span>
                        <span class="bg-slate-800 text-blue-400 px-2 py-0.5 rounded text-xs font-mono font-bold">${m.score} điểm</span>
                    </li>
                `).join('');

                teamEl.innerHTML = `
                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <h3 class="font-bold text-lg text-blue-400">Nhóm ${team.id}</h3>
                            <span class="text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-1 rounded">
                                TB: ${avgScore} điểm
                            </span>
                        </div>
                        <ul class="space-y-1">${membersList}</ul>
                    </div>
                    <div class="pt-2 border-t border-slate-800 text-xs text-slate-400 flex justify-between">
                        <span>Tổng số: ${team.members.length} người</span>
                        <span class="font-bold text-slate-200">Tổng điểm: ${team.totalScore}</span>
                    </div>
                `;
                container.appendChild(teamEl);
            });

            const diff = maxScore - minScore;
            document.getElementById('statBadge').innerText = `Chênh lệch tổng điểm giữa các nhóm: ${diff} điểm`;
        }
    </script>
</body>
</html>
